# ============================================================
# Construction Management App — Environment Variables
# Aurora PostgreSQL (IAM Auth) + Elastic Beanstalk + Cloudflare Pages
# ============================================================

# ── Aurora PostgreSQL ────────────────────────────────────────
DB_HOST=database-1.cluster-cvwu4y0ukbql.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
AWS_REGION=us-east-2
# DB_PASSWORD is NOT set — IAM auth generates tokens automatically
# For local dev, you can set DB_PASSWORD to use a static password instead

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ── AWS S3 (Photo Uploads) ──────────────────────────────────
S3_BUCKET_NAME=constructionmgmt-photos-prod
CLOUDFRONT_DOMAIN=d1abc123.cloudfront.net

# ── CORS (Cloudflare Pages Frontend) ────────────────────────
FRONTEND_URL=https://your-project.pages.dev

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
